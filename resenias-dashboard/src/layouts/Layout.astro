---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Blueprint Industrial-Tech · UPTlax' } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-[#0A0F1A] text-[#E6EDF7] font-sans antialiased min-h-screen">
    <slot />
  </body>
</html>
