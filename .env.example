# ========================================================
# Variables de entorno - Recolector UPTlax (Minería de Textos 7C)
# Copia este archivo a 'resenias-dashboard/.env' y completa los valores.
# ========================================================

# Base de datos Turso (libSQL en plan gratuito)
TURSO_DATABASE_URL="libsql://tu-base-de-datos.turso.io"
TURSO_AUTH_TOKEN="tu-token-de-turso-aqui"

# Secreto para que la aplicación móvil Expo sincronice registros por lotes (POST /api/sincronizar)
# Este token se captura en la pestaña 'Ajustes' de la app móvil.
SYNC_TOKEN="un-token-secreto-robusto-para-la-app"

# Secreto para acceder al panel administrativo (/admin) y a los endpoints de métricas y exportación
ADMIN_TOKEN="un-token-secreto-robusto-para-el-admin"
